# Скопируйте в .env.local и впишите свои бесплатные ключи. Файл .env.local в git не попадает.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# Необязательно: названия моделей меняются, при ошибке «модель не найдена» впишите актуальное.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
